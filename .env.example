# Runtime
NODE_ENV=production
DATABASE_URL=postgresql://postgres:replace-me@postgres:5432/clickify_mate
MONGODB_URL=mongodb://admin:replace-me@mongodb:27017/clickify_mate?authSource=admin
POSTGRES_PASSWORD=replace-with-a-long-random-password
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
GRAFANA_PASSWORD=replace-with-a-long-random-password

# Authentication (use different random values)
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_SECRET=replace-with-a-different-32-character-secret
ADMIN_USER=replace-admin-username
ADMIN_PASS=replace-with-a-strong-admin-password
ALLOW_SIGNUP=false
GOOGLE_OAUTH_ENABLED=false

# Encryption (64 hexadecimal characters each; never reuse a key)
AGENT_ENCRYPTION_KEY=replace-with-64-hex-characters
PAYMENT_CREDENTIALS_KEY=replace-with-a-different-64-hex-key

# Hosted payments
PAYMENT_PUBLIC_BASE_URL=https://pay.example.com
PAYMENT_SERVER_IPV4=203.0.113.10

# Provider webhooks
VERIFY_TOKEN=replace-with-a-random-meta-verify-token
META_APP_SECRET=replace-with-meta-app-secret
FB_APP_SECRET=replace-with-facebook-app-secret
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-telegram-secret
TELEGRAM_POLLING_ENABLED=false

# AI providers
GROQ_API_KEY=
NVIDIA_API_KEY=
AGENT_FAST_PROVIDER=groq
AGENT_FAST_MODEL=
AGENT_REASONING_PROVIDER=groq
AGENT_REASONING_MODEL=

# Password reset email
RESEND_API_KEY=
AUTH_EMAIL_FROM=no-reply@example.com

# Media/storage
MEDIA_ALLOWED_HOSTS=example-bucket.s3.example.com
B2_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Optional Supabase compatibility
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase / Firestore (JSON string or base64)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Admin alerting
ADMIN_EMAIL=admin@example.com
